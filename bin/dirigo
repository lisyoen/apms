#!/usr/bin/env node
const { spawnSync } = require("node:child_process");
const path = require("node:path");
const result = spawnSync(process.execPath, ["--import", "tsx", path.resolve(__dirname, "../src/cli/config.ts"), ...process.argv.slice(2)], { stdio: "inherit", env: process.env });
process.exit(result.status ?? 1);
