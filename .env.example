PORT=9107
# Dirigo environment variables use the DIRIGO_* prefix.
DATABASE_URL=postgresql://apms:CHANGE_ME@127.0.0.1:9108/apms
DB_PASSWORD=CHANGE_ME
DIRIGO_ADMIN_EMAIL=
DIRIGO_ADMIN_PASSWORD=
AUTH_SECRET=
DIRIGO_DATA_ROOT=./data
DIRIGO_WORKDIR_ALLOWLIST=
DIRIGO_SCHEDULER_INTERVAL_MS=10000
DIRIGO_SCHEDULER_INPROCESS=false
DIRIGO_MAX_WORKERS=20
DIRIGO_WORKER_RUNNER=opencode
DIRIGO_OPENCODE_BIN=
DIRIGO_SMTP_URL=
DIRIGO_SMTP_FROM=
DIRIGO_SHARE_LINK_TTL_DAYS=7
DIRIGO_LOGIN_MAX_ATTEMPTS=5
DIRIGO_LOGIN_LOCKOUT_MINUTES=15
# Signed JWT and persistent session-cookie lifetime (default: 24 hours).
DIRIGO_SESSION_TTL_HOURS=24
# Signed JWT and persistent session-cookie lifetime for automatic login (default: 30 days).
DIRIGO_REMEMBER_TTL_DAYS=30
# Optional SearXNG endpoint. When omitted, the web_search chat tool is not exposed.
DIRIGO_SEARXNG_URL=http://localhost:8889
